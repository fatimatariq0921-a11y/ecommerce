# Backend (Railway)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ecommerce_demo
JWT_SECRET=replace-with-strong-secret
PORT=5000
CLIENT_URL=https://your-app.vercel.app

# Vercel (server-side) — REQUIRED for login/signup on deployed site
API_URL=https://your-service.up.railway.app

# Optional — only if you want browser to call Railway directly (not needed if API_URL is set)
VITE_API_URL=
