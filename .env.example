# Backend (Railway → Variables tab — NOT a .env file on Railway)
# Copy the exact public URL from Railway → Settings → Networking
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/ecommerce_demo
JWT_SECRET=replace-with-long-random-secret
PORT=5000
CLIENT_URL=https://your-app.vercel.app
NODE_ENV=production

# Frontend (Vercel) — must match Railway public URL exactly
VITE_API_URL=https://ecommerce-api-production-xxxx.up.railway.app
